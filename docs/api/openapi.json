            "type": "string",
            "title": "Detail"
          },
          "codigo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Codigo",
            "description": "Nombre de la excepción de dominio"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorOut"
      },
      "EvaluacionOut": {
        "properties": {
          "operacion_id": {
            "type": "string",
            "title": "Operacion Id"
          },
          "puede_procesarse": {
            "type": "boolean",
            "title": "Puede Procesarse"
          },
          "motivos": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Motivos"
          },
          "beneficio_referencia": {
            "type": "boolean",
            "title": "Beneficio Referencia"
          },
          "total": {
            "type": "string",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
