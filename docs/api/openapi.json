  "components": {
    "schemas": {
      "CancelarIn": {
        "properties": {
          "motivo": {
            "type": "string",
            "title": "Motivo",
            "examples": [
              "El cliente ya no requiere el pedido"
            ]
          }
        },
        "type": "object",
        "required": [
          "motivo"
        ],
        "title": "CancelarIn"
      },
      "CrearOperacionIn": {
        "properties": {
          "actor_id": {
            "type": "string",
            "title": "Actor Id",
            "examples": [
              "FER-C001"
            ]
          },
          "lineas": {
            "items": {
              "$ref": "#/components/schemas/LineaIn"
            },
            "type": "array",
            "title": "Lineas"
          },
          "promocion_activa": {
            "type": "boolean",
            "title": "Promocion Activa",
            "default": false
          },
          "autorizado": {
            "type": "boolean",
            "title": "Autorizado",
            "default": true
          },
          "referencia": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Referencia"
          }
        },
        "type": "object",
        "required": [
          "actor_id"
        ],
        "title": "CrearOperacionIn"
      },
      "CreditoOut": {
        "properties": {
          "actor_id": {
            "type": "string",
            "title": "Actor Id"
          },
          "activo": {
