            "title": "Activo"
          },
          "es_preferente": {
            "type": "boolean",
            "title": "Es Preferente"
          },
          "credito_suspendido": {
            "type": "boolean",
            "title": "Credito Suspendido"
          },
          "operaciones_abiertas": {
            "type": "integer",
            "title": "Operaciones Abiertas"
          },
          "monto_abierto": {
            "type": "string",
            "title": "Monto Abierto"
          }
        },
        "type": "object",
        "required": [
          "actor_id",
          "activo",
          "es_preferente",
          "credito_suspendido",
          "operaciones_abiertas",
          "monto_abierto"
        ],
        "title": "CreditoOut"
      },
      "ErrorOut": {
        "properties": {
